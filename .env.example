# Token de API do Pipedrive (conta voahoteis2).
# Onde achar: Pipedrive > foto do perfil > Preferencias pessoais > API > "Seu token de API pessoal".
# Copie este arquivo para .env e cole o token abaixo. O .env NAO vai para o git.
PIPEDRIVE_API_TOKEN=

# Dominio da conta. Se o token for de outra conta, ajuste o subdominio.
PIPEDRIVE_BASE_URL=https://voahoteis2.pipedrive.com/api

# Deixe em 1 para rodar com dados falsos (sem tocar no Pipedrive), util para
# validar a UI antes de ter o token. Em producao deixe 0 ou remova.
PIPEDRIVE_MOCK=0

# Senha unica que o time digita para abrir o dashboard.
# Obrigatoria em producao: sem ela o dashboard responde 503 e nao abre (falha
# fechada de proposito -- esquecer a variavel nao pode publicar os dados).
# Em desenvolvimento local, se estiver vazia, o login e dispensado.
DASHBOARD_SENHA=

# Opcional. Segredo que assina o cookie de sessao. Sem ele, a assinatura usa a
# propria senha -- efeito colateral desejado: trocar a senha desloga todo mundo.
DASHBOARD_SEGREDO=
